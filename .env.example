# Copy to .env and fill in. Never commit .env.
# Generate AUTH_SECRET with:  python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# Fireworks (LLM)
FIREWORKS_API_KEY=
# Optional overrides. Defaults: deepseek-v4-pro-0813 (orchestrator), glm-5p3-flash (tone observer).
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro-0813
FIREWORKS_OBSERVER_MODEL=accounts/fireworks/models/glm-5p3-flash

# MongoDB Atlas (URL-encode any '@' in the password as %40)
MONGO_URI=mongodb://localhost:27017

# LangSmith tracing (optional). Get a key at https://smith.langchain.com
# Tracing is off unless LANGSMITH_API_KEY (or legacy LANGCHAIN_API_KEY) is set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Firstdesk
# Legacy aliases — still honoured if the LANGSMITH_* vars above are empty.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Firstdesk

# Hume (voice / emotion — optional, used by interview feature)
HUME_API_KEY=
HUME_CONFIG_ID=

# Resend (password reset email). Key at https://resend.com/api-keys
# Leave RESEND_API_KEY empty in dev: the reset link is logged instead of sent.
# RESEND_FROM must be on a domain verified in Resend or sending returns 403.
RESEND_API_KEY=
RESEND_FROM=FirstDesk <hello@securegrc.io>
RESEND_REPLY_TO=

# Public origin used to build reset links. Falls back to RAILWAY_PUBLIC_DOMAIN,
# then to the request host. Set it explicitly in production.
PUBLIC_BASE_URL=

# Demo account. Leave DEMO_PASSWORD empty in production to disable demo login.
DEMO_EMAIL=demo@firstdesk.app
DEMO_PASSWORD=

# Admin (analytics endpoint) — set a long random token in prod.
ADMIN_TOKEN=

# Hardening — set STRICT_ENV=1 in production to fail fast on missing secrets.
STRICT_ENV=0
